<?xml version="1.0" encoding="utf-8"?>
<!--
  AG-01 PoC (WFF 5): WFF 5 Group blendMode and ComplicationSlot blendMode,
  combined with WFF 5 Stroke join, Font minSize, Text lineSpacing/verticalAlign,
  plus WFF 4 Variant AOD continuity and Reference data sharing.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />
    <Scene backgroundColor="#FF000000">
        <!-- WFF 5 exclusive: blendMode="SCREEN" directly on <Group> container -->
        <Group name="ActiveDecoration" x="0" y="0" width="450" height="450" alpha="255" blendMode="SRC_OVER">
            <Variant mode="AMBIENT" target="alpha" value="0" startOffset="0.10" duration="0.85" interpolation="EASE_OUT" />

            <!-- Single-source WFF 4/5 Reference publisher using Group container -->
            <Group name="Wff5ReferencePublisher" x="50" y="0" width="240" height="1" alpha="0" tintColor="#FF79D4F2">
                <Transform target="x" value="clamp([STEP_PERCENT], 0, 100)" />
                <Transform target="tintColor" value="[BATTERY_PERCENT] &lt;= 15 ? #FFFFA84D : #FF79D4F2" />
                <Reference name="ref_wff5_progress" source="x" defaultValue="50" />
                <Reference name="ref_wff5_accent" source="tintColor" defaultValue="#FF79D4F2" />
            </Group>

            <!-- WFF 5 exclusive: nested <Group> with blendMode="SCREEN" and <Stroke join="ROUND"> -->
            <Group name="OpticalCrystalBlendGroup" x="0" y="0" width="450" height="450" blendMode="SCREEN">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Ellipse x="15" y="15" width="420" height="420">
                        <Stroke color="#FF314B60" thickness="2" join="ROUND" />
                    </Ellipse>
                    <Arc centerX="225" centerY="225" width="412" height="412" startAngle="0" endAngle="180" direction="CLOCKWISE">
                        <Transform target="endAngle" value="[REFERENCE.ref_wff5_progress] * 3.6" />
                        <Stroke color="#FF79D4F2" thickness="4" cap="ROUND" join="ROUND">
                            <Transform target="color" value="[REFERENCE.ref_wff5_accent]" />
                        </Stroke>
                    </Arc>
                    <RoundRectangle x="85" y="242" width="280" height="46" cornerRadiusX="23" cornerRadiusY="23">
                        <Fill color="#FF101E2A" />
                        <Stroke color="#FF314B60" thickness="1" join="BEVEL" />
                    </RoundRectangle>
                </PartDraw>
            </Group>

            <!-- WFF 5 exclusive: <Text lineSpacing="..." verticalAlign="CENTER" isAutoSize="TRUE"> and <Font minSize="14"> -->
            <PartText x="135" y="50" width="180" height="30">
                <Text align="CENTER" verticalAlign="CENTER" lineSpacing="1.0" isAutoSize="TRUE">
                    <Font family="SYNC_TO_DEVICE" size="16" minSize="12" color="#FF79D4F2">
                        <Transform target="color" value="[REFERENCE.ref_wff5_accent]" />
                        AURA ULTRA
                    </Font>
                </Text>
            </PartText>
            <PartText x="90" y="88" width="270" height="36">
                <Text align="CENTER" verticalAlign="CENTER" lineSpacing="0.5" isAutoSize="TRUE">
                    <Font family="SYNC_TO_DEVICE" size="22" minSize="14" color="#FFA9BACB">
                        <Template>%s.%s · %s<Parameter expression="[MONTH_Z]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[DAY_OF_WEEK_S]" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText x="95" y="248" width="260" height="34">
                <Text align="CENTER" verticalAlign="CENTER" isAutoSize="TRUE">
                    <Font family="SYNC_TO_DEVICE" size="21" minSize="14" color="#FF79D4F2">
                        <Template>BAT %s%% · STEP %s%%<Parameter expression="[BATTERY_PERCENT]" /><Parameter expression="round([REFERENCE.ref_wff5_progress])" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- WFF 5 exclusive: blendMode="SCREEN" directly on <ComplicationSlot> -->
        <ComplicationSlot name="Wff5BlendedComplicationSlot" slotId="1" x="95" y="300" width="260" height="68"
                          supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY" isCustomizable="TRUE" blendMode="SCREEN">
            <Variant mode="AMBIENT" target="alpha" value="0" startOffset="0.30" duration="0.70" interpolation="EASE_IN" />
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingRoundBox x="0" y="0" width="260" height="68" cornerRadius="18" />
            <Complication type="SHORT_TEXT">
                <PartText x="15" y="16" width="230" height="36">
                    <Text align="CENTER" verticalAlign="CENTER" isAutoSize="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" minSize="12" color="#FFF3F7FA">
                            <Template>%s %s<Parameter expression="[COMPLICATION.TITLE]" /><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="15" y="16" width="230" height="36">
                    <Text align="CENTER" verticalAlign="CENTER" isAutoSize="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" minSize="12" color="#FF81D7AF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="15" y="16" width="230" height="36">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" minSize="12" color="#FFA9BACB">--</Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Primary Clock with WFF 4/5 continuous AOD Variant transition -->
        <DigitalClock x="40" y="131" width="370" height="118" pivotX="0.5" pivotY="0.5" scaleX="1.0" scaleY="1.0" alpha="255" tintColor="#FFF3F7FA">
            <Variant mode="AMBIENT" target="y" value="166" startOffset="0.00" duration="0.85" interpolation="EASE_IN_OUT" />
            <Variant mode="AMBIENT" target="scaleX" value="0.88" startOffset="0.00" duration="0.85" interpolation="EASE_IN_OUT" />
            <Variant mode="AMBIENT" target="scaleY" value="0.88" startOffset="0.00" duration="0.85" interpolation="EASE_IN_OUT" />
            <Variant mode="AMBIENT" target="tintColor" value="#FFB7C0C9" startOffset="0.00" duration="0.85" interpolation="EASE_IN_OUT" />
            <TimeText x="0" y="0" width="370" height="118" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" verticalAlign="CENTER" alpha="255">
                <Font family="SYNC_TO_DEVICE" size="96" weight="NORMAL" color="#FFF3F7FA" />
            </TimeText>
        </DigitalClock>
    </Scene>
</WatchFace>
